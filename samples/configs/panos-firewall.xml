<config version="10.2.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <deviceconfig><system><hostname>plant-pa-1</hostname>
        <permitted-ip><entry name="0.0.0.0/0"/></permitted-ip>
        <password>should-never-appear-in-output</password></system></deviceconfig>
      <network>
        <interface>
          <ethernet>
            <entry name="ethernet1/1"><layer3><ip><entry name="203.0.113.2/24"/></ip></layer3></entry>
            <entry name="ethernet1/2"><layer3><ip><entry name="10.20.0.1/16"/></ip></layer3></entry>
            <entry name="ethernet1/3"><layer3><ip><entry name="10.30.0.1/16"/></ip></layer3></entry>
          </ethernet>
        </interface>
      </network>
      <vsys>
        <entry name="vsys1">
          <zone>
            <entry name="untrust"><network><layer3><member>ethernet1/1</member></layer3></network></entry>
            <entry name="eng"><network><layer3><member>ethernet1/2</member></layer3></network></entry>
            <entry name="ot"><network><layer3><member>ethernet1/3</member></layer3></network></entry>
          </zone>
          <address>
            <entry name="ews"><ip-netmask>10.20.1.15</ip-netmask></entry>
            <entry name="ews2"><ip-netmask>10.20.1.16/32</ip-netmask></entry>
            <entry name="plc-net"><ip-netmask>10.30.2.0/24</ip-netmask></entry>
            <entry name="hist"><ip-range>10.30.5.10-10.30.5.12</ip-range></entry>
            <entry name="vendor"><fqdn>updates.vendor.example</fqdn></entry>
          </address>
          <address-group>
            <entry name="eng-hosts"><static><member>ews</member><member>ews2</member></static></entry>
            <entry name="eng-all"><static><member>eng-hosts</member></static></entry>
            <entry name="tagged"><dynamic><filter>'ot-critical'</filter></dynamic></entry>
          </address-group>
          <service>
            <entry name="svc-modbus"><protocol><tcp><port>502</port></tcp></protocol></entry>
            <entry name="svc-enip"><protocol><tcp><port>44818,2222</port></tcp></protocol></entry>
            <entry name="svc-snmp"><protocol><udp><port>161-162</port></udp></protocol></entry>
          </service>
          <service-group>
            <entry name="ics-svcs"><members><member>svc-modbus</member><member>svc-enip</member></members></entry>
          </service-group>
          <rulebase>
            <security>
              <rules>
                <entry name="eng-to-plc">
                  <from><member>eng</member></from><to><member>ot</member></to>
                  <source><member>eng-all</member></source><destination><member>plc-net</member></destination>
                  <source-user><member>any</member></source-user><application><member>any</member></application>
                  <service><member>ics-svcs</member></service><action>allow</action><log-end>yes</log-end>
                </entry>
                <entry name="eng-to-plc-apps">
                  <from><member>eng</member></from><to><member>ot</member></to>
                  <source><member>any</member></source><destination><member>plc-net</member></destination>
                  <application><member>modbus</member><member>ssh</member></application>
                  <service><member>application-default</member></service><action>allow</action>
                </entry>
                <entry name="cleanup-deny">
                  <from><member>any</member></from><to><member>any</member></to>
                  <source><member>any</member></source><destination><member>any</member></destination>
                  <application><member>any</member></application><service><member>any</member></service>
                  <action>deny</action>
                </entry>
                <entry name="disabled-rdp">
                  <from><member>eng</member></from><to><member>ot</member></to>
                  <source><member>any</member></source><destination><member>hist</member></destination>
                  <service><member>any</member></service><action>allow</action><disabled>yes</disabled>
                </entry>
                <entry name="ot-updates">
                  <from><member>ot</member></from><to><member>untrust</member></to>
                  <source><member>plc-net</member></source><destination><member>vendor</member></destination>
                  <service><member>service-https</member></service><action>allow</action>
                </entry>
                <entry name="ot-not-plc">
                  <from><member>ot</member></from><to><member>eng</member></to>
                  <source><member>plc-net</member></source><destination><member>eng-all</member></destination>
                  <negate-destination>yes</negate-destination>
                  <service><member>svc-snmp</member></service><action>allow</action>
                </entry>
                <entry name="intra-ot-only">
                  <from><member>ot</member></from><to><member>ot</member></to>
                  <source><member>any</member></source><destination><member>any</member></destination>
                  <service><member>any</member></service><action>deny</action><rule-type>intrazone</rule-type>
                </entry>
                <entry name="tagged-in">
                  <from><member>untrust</member></from><to><member>ot</member></to>
                  <source><member>tagged</member></source><destination><member>any</member></destination>
                  <service><member>any</member></service><action>allow</action>
                </entry>
              </rules>
            </security>
            <nat>
              <rules>
                <entry name="dnat-hist">
                  <from><member>untrust</member></from><to><member>untrust</member></to>
                  <source><member>any</member></source><destination><member>ews</member></destination>
                  <destination-translation><translated-address>hist</translated-address></destination-translation>
                </entry>
                <entry name="snat-out">
                  <from><member>eng</member></from><to><member>untrust</member></to>
                  <source><member>eng-all</member></source><destination><member>any</member></destination>
                  <source-translation><dynamic-ip-and-port><interface-address><interface>ethernet1/1</interface></interface-address></dynamic-ip-and-port></source-translation>
                </entry>
              </rules>
            </nat>
          </rulebase>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
