{
  "name": "OkieOTSec",
  "version": "1.1",
  "color": {
    "blue":      { "value": "#2E6CB5", "use": "Primary. Logo, links, buttons." },
    "navy":      { "value": "#14365C", "use": "Title slides, app tile, headers." },
    "sky":       { "value": "#6BB0EC", "use": "OT and links on dark." },
    "copper":    { "value": "#C56A33", "use": "Accent only. Never body text, never status." },
    "copperDark":{ "value": "#E08A4E", "use": "Copper on dark backgrounds." },
    "cream":     { "value": "#FAF4E8", "use": "Light surface." },
    "ink":       { "value": "#13202E", "use": "Body text." },
    "inkDeep":   { "value": "#0D1520", "use": "Dark surface." }
  },
  "theme": {
    "light": { "bg": "#FAF4E8", "surface": "#FFFDF8", "line": "#E6DCC8", "text": "#13202E", "muted": "#5B6672", "brand": "#2E6CB5", "link": "#2E6CB5", "accent": "#C56A33", "buttonBg": "#2E6CB5", "buttonText": "#FFFFFF" },
    "dark":  { "bg": "#0D1520", "surface": "#141F2C", "line": "#263445", "text": "#E8EDF2", "muted": "#9AA8B6", "brand": "#6BB0EC", "link": "#6BB0EC", "accent": "#E08A4E", "buttonBg": "#2E6CB5", "buttonText": "#FFFFFF" }
  },
  "risk": {
    "now":   { "value": "#D7263D", "label": "NOW" },
    "next":  { "value": "#E9A23B", "label": "NEXT" },
    "never": { "value": "#6B7682", "label": "NEVER" }
  },
  "contrast": {
    "ink on cream": 15.1, "cream on navy": 11.2, "sky on ink": 7.9, "white on blue": 5.4,
    "sky on navy": 5.3, "blue on cream": 4.9, "copper-dark on navy": 4.6, "copper on cream": 3.5
  },
  "font": {
    "display": { "family": "Space Grotesk", "weights": [500, 700], "use": "Wordmark, titles", "fallback": "Segoe UI, Arial" },
    "body":    { "family": "IBM Plex Sans", "weights": [400, 600], "use": "Body text", "fallback": "Segoe UI, Arial" },
    "mono":    { "family": "IBM Plex Mono", "weights": [400, 600], "use": "Protocol values, tags, addresses", "fallback": "Consolas" },
    "license": "SIL Open Font License 1.1 (Google Fonts)"
  },
  "logoGlow": { "color": "#6BB0EC", "blur": [10, 4], "use": "Dark backgrounds and hero sizes only (64 px and up). Never on light." }
}
